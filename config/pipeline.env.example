# Core inputs
FASTQ_DIR="$projPath/fastq"
READ1_SUFFIX="_R1.fastq.gz"
READ2_SUFFIX="_R2.fastq.gz"
TRIM_READ1_SUFFIX="_R1_val_1.fq.gz"
TRIM_READ2_SUFFIX="_R2_val_2.fq.gz"

STAR_FASTA="/path/to/reference.fa"
STAR_GTF="/path/to/annotation.gtf"
STAR_INDEX_DIR="$projPath/reference/star_index"

# Optional output overrides
RAW_FASTQC_DIR="$projPath/fastqc_raw"
TRIM_DIR="$projPath/trim_output"
ALIGN_DIR="$projPath/star_align"
COUNTS_DIR="$projPath/counts"
MULTIQC_DIR="$projPath/multiqc"

# Optional module names for HPC environments that use environment modules.
FASTQC_MODULE=""
TRIM_GALORE_MODULE=""
STAR_MODULE=""
SAMTOOLS_MODULE=""
FEATURECOUNTS_MODULE=""
MULTIQC_MODULE=""

# Example site-specific module values:
# FASTQC_MODULE="fastqc/0.11.9"
# TRIM_GALORE_MODULE="trim_galore/0.6.6"
# STAR_MODULE="STAR/2.7.9a"
# SAMTOOLS_MODULE="bbc/samtools/samtools-1.12"
# FEATURECOUNTS_MODULE="subread/2.0.6"
# MULTIQC_MODULE="bbc/multiqc/multiqc-1.11"

# Tunable parameters
FASTQC_THREADS=2
TRIM_GALORE_CORES=4
TRIM_MIN_LENGTH=50
STAR_INDEX_THREADS=16
STAR_ALIGN_THREADS=12
STAR_SJDB_OVERHANG=100
FEATURECOUNTS_THREADS=12

# featureCounts strandedness codes:
#   0 = unstranded
#   1 = stranded
#   2 = reversely stranded
# The original bulk workflow used reverse-stranded counting.
FEATURECOUNTS_STRAND=2
FEATURECOUNTS_FEATURE_TYPE="exon"
FEATURECOUNTS_ATTRIBUTE_TYPE="gene_id"
MULTIQC_REPORT_NAME="multiqc_rnaseq_report.html"
